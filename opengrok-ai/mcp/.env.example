# ===== OpenGrok REST API =====
OPENGROK_BASE_URL=http://localhost:8081/api/v1

# ===== 鉴权 =====
# OPENGROK_AUTH_TYPE=   "bearer" 表示带上 Authorization: Bearer 请求头；
#                       "none"  （默认）表示不带任何鉴权。
# OPENGROK_TOKEN=       当 OPENGROK_AUTH_TYPE=bearer 时必填。
#                       使用方式与 curl -H "Authorization: Bearer $OPENGROK_TOKEN" 一致。
OPENGROK_AUTH_TYPE=none
OPENGROK_TOKEN=

# ===== HTTP 传输选项 =====
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3001

# ===== 写工具总闸门 =====
# 设为 false（默认）时，所有破坏性 / 写工具都不会注册。
# 设为 true 时才会把写工具暴露给 MCP 客户端。
# 读工具（search / list / get 等）始终可用。
ENABLE_WRITE_TOOLS=false

# ===== 其它 =====
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
