{
  "name": "opengrok-mcp",
  "version": "0.1.0",
  "description": "MCP server for OpenGrok — expose OpenGrok REST API (full CRUD) as Model Context Protocol tools, with stdio / SSE / Streamable HTTP transports.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opengrok-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts --stdio",
    "dev:sse": "tsx watch src/index.ts --sse --port 3001",
    "dev:http": "tsx watch src/index.ts --http --port 3002",
    "build": "tsc -p .",
    "start": "node dist/index.js --stdio",
    "start:sse": "node dist/index.js --sse --port 3001",
    "start:http": "node dist/index.js --http --port 3002",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js --stdio",
    "inspect:dev": "npx -y @modelcontextprotocol/inspector tsx src/index.ts --stdio",
    "install:claude": "powershell -ExecutionPolicy Bypass -File scripts/install-claude.ps1",
    "validate:skills": "node ../skills/scripts/validate-skills.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opengrok",
    "source-code-search",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "李春俊-Rhyme"
}
