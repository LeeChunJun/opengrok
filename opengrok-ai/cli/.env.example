# ===== OpenGrok REST API =====
OPENGROK_BASE_URL=http://localhost:8081/api/v1

# ===== 鉴权（与 opengrok-mcp 完全一致）=====
OPENGROK_AUTH_TYPE=none
OPENGROK_TOKEN=

# ===== HTTP / 终端选项 =====
# 是否启动时自动 ping OpenGrok；若为 true，连接失败会立即报错退出
OPENGROK_PING_ON_START=true

# 每次搜索默认返回条数（CLI 默认 50，TUI 模式可覆盖）
OPENGROK_DEFAULT_MAX_RESULTS=50

# ===== Misc =====
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
