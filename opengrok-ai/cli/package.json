{
  "name": "opengrok-cli",
  "version": "0.1.0",
  "description": "OpenGrok 的交互式终端客户端（TUI），底层调用 OpenGrok REST API。配套 opengrok-mcp 使用。",
  "type": "module",
  "main": "src/index.tsx",
  "bin": {
    "opengrok-cli": "src/index.tsx"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "dev:headless": "bun run src/index.tsx --headless",
    "start": "bun run src/index.tsx",
    "search": "bun run src/index.tsx --headless search",
    "list-projects": "bun run src/index.tsx --headless list-projects",
    "get-file": "bun run src/index.tsx --headless get-file",
    "blame": "bun run src/index.tsx --headless blame",
    "history": "bun run src/index.tsx --headless history",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "react": "^19.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.7.5",
    "@types/react": "^19.2.0",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "keywords": [
    "opentui",
    "tui",
    "opengrok",
    "cli",
    "source-code-search"
  ],
  "license": "MIT",
  "author": "李春俊-Rhyme"
}
