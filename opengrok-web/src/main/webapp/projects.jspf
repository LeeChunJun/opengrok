<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="
java.net.URLEncoder,
java.nio.charset.StandardCharsets,
org.opengrok.web.PageConfig"%>

<%
/* ---------------------- projects.jspf start ---------------------
 *
 * Cookie persistence for the project selection. Writes the
 * OPEN_GROK_PROJECT cookie whenever the user has at least one
 * project selected. Does not produce any HTML.
 *
 * Variables are prefixed `_p_` so the calling JSP's body block
 * (which may declare its own `cfg`, etc.) does not collide.
 */
{
    /* Use UTF-8 if no encoding is specified in the request. */
    if (request.getCharacterEncoding() == null) {
        request.setCharacterEncoding("UTF-8");
    }

    PageConfig _chromeProjectsCfg = PageConfig.get(request);

    String _pProjects = _chromeProjectsCfg.getRequestedProjectsAsString();
    if (_pProjects.length() != 0) {
        Cookie _pCookie = new Cookie(PageConfig.OPEN_GROK_PROJECT,
                URLEncoder.encode(_pProjects, StandardCharsets.UTF_8));
        response.addCookie(_pCookie);
    }
}
/* ---------------------- projects.jspf end --------------------- */
%>