<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page errorPage="error.jsp" import="
java.io.BufferedInputStream,
java.io.File,
java.io.FileInputStream,
java.io.InputStream,
java.io.InputStreamReader,
java.io.IOException,
java.nio.charset.StandardCharsets,
java.util.logging.Level,
org.opengrok.indexer.analysis.AnalyzerGuru,
org.opengrok.indexer.analysis.Ctags,
org.opengrok.indexer.analysis.Definitions,
org.opengrok.indexer.analysis.AbstractAnalyzer,
org.opengrok.indexer.analysis.AbstractAnalyzer.Genre,
org.opengrok.indexer.analysis.AnalyzerFactory,
org.opengrok.indexer.history.Annotation,
org.opengrok.indexer.history.HistoryGuru,
org.opengrok.indexer.util.ObjectPool,
org.opengrok.indexer.util.IOUtils,
org.opengrok.indexer.web.QueryParameters,
org.opengrok.indexer.web.Util,
org.opengrok.web.PageConfig"%>
<%@ page import="static org.opengrok.web.PageConfig.DUMMY_REVISION" %>

<style>
/* ── xref "paper" wrapper ──
 *
 * xref.jspf emits <div id="src" class="xref-paper">…</div>. list.jsp
 * (code-view branch) used to wrap the include in a plain <pre>, which
 * is invalid HTML for a <div> child. The wrap is gone now (see the
 * code-view block below) and the .xref-paper class carries the entire
 * surface styling — border, shadow, monospace, line-number gutter,
 * etc. Styles here therefore only need to style the wrapper itself
 * plus its <pre> child. */
.xref-paper {
    background: var(--surface);
    border: 1px solid #e3e6eb;
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    overflow: hidden;
}
.xref-paper-inner { padding: 4px 0; }
.xref-paper-binary .xref-paper-inner {
    padding: 28px 24px;
    text-align: center;
    color: var(--muted);
    font-size: 14px;
}
.xref-paper-binary .xref-paper-inner a { color: var(--accent); }
.xref-paper-image .xref-paper-inner {
    padding: 24px;
    text-align: center;
    background: #f6f8fa;
}
.xref-paper-image .xref-paper-inner img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
}
/* Inner dumped-xref <pre> — same look as the readme preview gutter so
 * the code view and the readme preview read as one component family. */
.xref-paper pre {
    margin: 0;
    padding: 12px 0;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.7;
    color: #2f3640;
    white-space: pre;
    background: #fbfcfd;
}
.xref-paper pre a.l,
.xref-paper pre a.hl {
    display: inline-block;
    width: 3.5em;
    min-width: 3.5em;
    text-align: right;
    padding: 0 .4em 0 .4em;
    margin-right: .5em;
    background-color: #f6f8fa;
    color: #8b949e;
    user-select: none;
    text-decoration: none;
    font-size: 11px;
    font-family: var(--font-mono);
    border: 0;
}
.xref-paper pre a.l:hover { color: var(--accent); }
.xref-paper pre a.hl { color: var(--accent); font-weight: 600; }
/* Goto-line target highlight — when URL has #N, light up that row's
 * gutter anchor (matches original style-1.0.6.css rule). */
.xref-paper div[id^='src'] a.l:target,
.xref-paper div[id^='src'] a.hl:target {
    background: var(--accent-dim);
    color: var(--accent);
}
.xref-paper pre a:not(.l):not(.hl) { color: var(--accent); text-decoration: none; }
.xref-paper pre a:not(.l):not(.hl):hover { text-decoration: underline; }
.xref-paper pre span.scope-head { display: inline; }
.xref-paper pre span.scope-body { display: inline; }
/* Annotate mode ("blame" column). The xref dump emits, for each
 * annotated line, after the line-number anchor:
 *   <span class="blame">
 *       <a class="r title-tooltip" ...>rev</a>
 *       <a class="search" ...></a>
 *       <span class="a">author</span>
 *   </span>
 * In the original style-1.0.6.css all three classes share a single
 * rule with `.l, .hl` (display: inline-block, 6ex wide, gutter
 * background). Without those rules the author/revision text breaks
 * out of the gutter and overlaps the line-number column. */
.xref-paper pre a.r,
.xref-paper pre span.a {
    display: inline-block;
    width: 6em;
    text-align: right;
    padding: 0 .4em 0 .4em;
    margin-right: .5em;
    background-color: #f6f8fa;
    color: #6e7681;
    font-size: 11px;
    font-family: var(--font-mono);
    user-select: none;
    text-decoration: none;
    vertical-align: top;
}
.xref-paper pre a.r:hover { color: var(--accent); text-decoration: underline; }
.xref-paper pre a.search {
    display: inline-block;
    width: 1.4em;
    background-color: #f6f8fa;
    color: #6e7681;
    font-size: 11px;
    text-align: center;
    margin-right: .5em;
    text-decoration: none;
}
.xref-paper pre a.search:hover { color: var(--accent); text-decoration: none; }
.xref-paper pre span.most_recent_revision { font-weight: 600; color: var(--accent); }
/* Hide the scope-signature span (it lives between the line-number
 * anchor and the rest of the line; original style-1.0.6.css hides it
 * via display: none and the JS shows it again when the scope is
 * folded). Without this rule the signature text leaks back into the
 * gutter area on every scope-start line. */
.xref-paper pre span.scope-signature { display: none; }
/* Symbol-colour classes used by the xref dump. The CSS class comes
 * from XrefStyle.ssClass — different colours per definition type
 * (class vs method vs field vs …). Without these rules, every
 * definition link would fall through to the generic
 * `a:not(.l):not(.hl)` rule above and inherit the single accent
 * colour. Mirrors the per-class colours from the original
 * default/style-1.0.4.css. */
.xref-paper a.xm              { color: #c66; font-weight: 700; }
.xref-paper a.xa              { color: #60c; font-weight: 700; }
.xref-paper a.xl              { color: #963; font-weight: 700; }
.xref-paper a.xv              { color: #c30; font-weight: 700; }
.xref-paper a.xc              { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xp              { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xi              { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xn              { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xe              { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xer             { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xs              { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xt              { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xts             { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xu              { color: #909; font-weight: 700; font-style: italic; }
.xref-paper a.xfld            { color: #090; font-weight: 700; }
.xref-paper a.xmb             { color: #090; font-weight: 700; }
.xref-paper a.xf              { color: #00f; font-weight: 700; }
.xref-paper a.xmt             { color: #00f; font-weight: 700; }
.xref-paper a.xsr             { color: #00f; font-weight: 700; }
.xref-paper a.xlbl            { color: red;  font-weight: 700; background-color: yellow; }
.xref-paper a.xr              { color: #909; font-weight: 700; }
.xref-paper a.d               { color: #909; font-weight: 700; }
.xref-paper a.scope           { color: steelblue; font-weight: 700; padding-left: 1ex;  }
.xref-paper pre span.fold-icon,
.xref-paper pre span.unfold-icon,
.xref-paper pre span.fold-space {
    display: inline-block;
    width: 11px; height: 11px;
    margin: 0 .2em;
}
.xref-paper pre span.fold-icon { background-image: url('<%= request.getContextPath() %>/default/img/folding.png'); background-repeat: no-repeat; }
.xref-paper pre span.unfold-icon { background-image: url('<%= request.getContextPath() %>/default/img/unfolding.png'); background-repeat: no-repeat; }

/* `body.lines-hidden` (toggled by utils.js lntoggle()) must beat the
 * `.xref-paper pre a.l { display: inline-block }` rule above so the
 * Line button can hide the gutter when the xref is rendered through
 * xref.jspf instead of list.jsp's direct-render branch. Same for
 * `.hl`. The original rule lives in style-1.0.6.css but is
 * overridden by specificity, so we reproduce it here at higher
 * specificity. */
body.lines-hidden .xref-paper pre a.l,
body.lines-hidden .xref-paper pre a.hl {
    display: none !important;
}
body.lines-hidden .xref-paper pre a.r,
body.lines-hidden .xref-paper pre a.search,
body.lines-hidden .xref-paper pre span.a {
    display: none !important;
}
body.lines-hidden .xref-paper pre span.fold-space,
body.lines-hidden .xref-paper pre span.fold-icon,
body.lines-hidden .xref-paper pre span.unfold-icon {
    display: none !important;
}

/* NOTE: the floating-window styles (.window / .window-header /
 * .window-body / .intelli-window / .scopes-window / .navigate-window /
 * .diff_navigation_style / .symbol-highlighted.* / #intelli_win /
 * #scopes_win / #navigate_win) used to be duplicated here verbatim
 * from list.jsp. They were removed: this fragment is pulled in by a
 * static include directive ONLY from list.jsp's code-view branch,
 * and that page always emits those rules itself in its own style
 * block. Keeping two identical copies in the same document doubled
 * the CSS payload on every source-file page and meant any future
 * tweak had to be made in two places. If this fragment is ever
 * included by a page that does NOT carry list.jsp's chrome, move the
 * shared rules into httpheader.jspf rather than re-duplicating them
 * here. */

/* xref error block (emitted by xref.jspf when reading fails). Pairs
 * with the .xref-paper card style so the error state visually matches
 * the success state instead of looking like raw browser text. */
.xref-error {
    background: #fff5f5;
    border: 1px solid #f3c2c2;
    border-left: 3px solid #cf222e;
    border-radius: 8px;
    padding: 14px 18px;
    margin: 16px 0;
    color: #6b1f1f;
}
.xref-error h3 {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 600;
    color: #cf222e;
}
.xref-error p.error {
    margin: 0;
    font-size: 12.5px;
    font-family: var(--font-mono);
    color: #6b1f1f;
    white-space: pre-wrap;
}
</style>

<%
/* ---------------------- xref.jspf start ---------------------
 *
 * Xref renderer. Included by list.jsp (and other pages that need
 * to render the cross-reference view of a file). Produces one of:
 *   - <div id="src">…</div> with the rendered Xref / image / HTML
 *   - <h3 class="error">…</h3> + error <p> when reading fails
 *
 * The helper relies on a number of already-declared variables in
 * the calling page's _jspService scope:
 *   LOGGER, basename, rev, resourceFile, rawPath, project
 *   navigateWindowEnabled  (String "true" / "false" — emitted as the
 *                           data-navigate-window-enabled attribute on
 *                           each <div id="src"> so the Navigate popup
 *                           can auto-open when the project allows it)
 *   r  (declared as InputStreamReader, may be assigned below)
 *
 * The PageConfig is obtained here as `xrefCfg` so that this fragment
 * compiles both in Jetty JSPC pre-compilation (where the fragment is
 * compiled as a stand-alone JSP and `cfg` is not in scope) and at
 * runtime under a static include directive. Calling
 * PageConfig.get(request) is cached, so this is safe even if the
 * calling page already obtained its own PageConfig under a different
 * name (e.g. list.jsp's `_chromeListCfg`).
 */
PageConfig xrefCfg = PageConfig.get(request);
{
    /* Requesting a previous revision or needed to generate xref on the fly
     * (either economy mode is enabled or the cfg.findDataFile() call failed). */
    AnalyzerFactory _xrefA = AnalyzerGuru.find(basename);
    Genre _xrefG = AnalyzerGuru.getGenre(_xrefA);
    String _xrefError = null;
    /* xref-paper class is applied to each emitted <div id="src"> so the
     * theme-aware "paper" styles in list.jsp can target the rendered
     * cross-reference view consistently with the readme previews. */

    if (_xrefG == Genre.PLAIN || _xrefG == Genre.HTML || _xrefG == null) {
        InputStream _xrefIn = null;
        File _xrefTempf = null;
        try {
            if (rev.isBlank() || rev.equals(DUMMY_REVISION)) {
                _xrefIn = new BufferedInputStream(new FileInputStream(resourceFile));
            } else {
                _xrefTempf = File.createTempFile("ogtags", basename);
                if (HistoryGuru.getInstance().getRevision(_xrefTempf, resourceFile.getParent(), basename, rev)) {
                    _xrefIn = new BufferedInputStream(new FileInputStream(_xrefTempf));
                } else {
                    LOGGER.log(Level.WARNING, "failed to retrieve history contents of {0} in revision {1}",
                            new Object[]{resourceFile, rev});
                    _xrefTempf.delete();
                    _xrefTempf = null;
                }
            }
        } catch (Exception e) {
            /* Fall through to error message. */
            _xrefError = e.getMessage();
            if (_xrefTempf != null) {
                _xrefTempf.delete();
                _xrefTempf = null;
            }
        }

        if (_xrefIn != null) {
            try {
                if (_xrefG == null) {
                    _xrefA = AnalyzerGuru.find(_xrefIn, basename);
                    _xrefG = AnalyzerGuru.getGenre(_xrefA);
                }
                if (_xrefG == AbstractAnalyzer.Genre.DATA || _xrefG == AbstractAnalyzer.Genre.XREFABLE || _xrefG == null) {
%>
<div id="src" class="xref-paper xref-paper-binary" data-navigate-window-enabled="<%= navigateWindowEnabled %>">
    <div class="xref-paper-inner">
    Download binary file, <a href="<%= rawPath %>?<%= QueryParameters.REVISION_PARAM_EQ %>
<%= Util.uriEncode(rev) %>"><%= basename %></a>
    </div>
</div><%
                } else {
%>
<div id="src" class="xref-paper" data-navigate-window-enabled="<%= navigateWindowEnabled %>">
        <pre><%
                    if (_xrefG == AbstractAnalyzer.Genre.PLAIN) {
                        Definitions _xrefDefs = null;
                        ObjectPool<Ctags> _xrefCtagsPool = xrefCfg.getEnv().getIndexerParallelizer().getCtagsPool();
                        int _xrefTries = 2;
                        while (xrefCfg.getEnv().isWebappCtags() && _xrefTempf != null) {
                            Ctags _xrefCtags = _xrefCtagsPool.get();
                            try {
                                _xrefCtags.setTabSize(project != null ?
                                project.getTabSize() : 0);
                                _xrefDefs = _xrefCtags.doCtags(_xrefTempf.getPath());
                                break;
                            } catch (InterruptedException ex) {
                                if (--_xrefTries > 0) {
                                    LOGGER.log(Level.WARNING, "doCtags() interrupted--{0}",
                                    ex.getMessage());
                                    continue;
                                }
                                LOGGER.log(Level.WARNING, "doCtags()", ex);
                                break;
                            } catch (Exception ex) {
                                LOGGER.log(Level.WARNING, "doCtags()", ex);
                                break;
                            } finally {
                                _xrefCtags.reset();
                                _xrefCtagsPool.release(_xrefCtags);
                            }
                        }
                        Annotation _xrefAnnotation = xrefCfg.getAnnotation();
                        /* Not needed yet. */
                        /* _xrefAnnotation.writeTooltipMap(out); */
                        /* The data under source root is read with UTF-8 as a default. */
                        r = IOUtils.createBOMStrippedReader(_xrefIn, StandardCharsets.UTF_8.name());
                        AnalyzerGuru.writeDumpedXref(request.getContextPath(),
                            _xrefA, r, out,
                            _xrefDefs, _xrefAnnotation, project, resourceFile);
                    } else if (_xrefG == AbstractAnalyzer.Genre.IMAGE) {
        %></pre>
    <img src="<%= rawPath %>?<%= QueryParameters.REVISION_PARAM_EQ %><%= Util.uriEncode(rev) %>" alt="from Source Repository"/>
    <pre><%
                    } else if (_xrefG == AbstractAnalyzer.Genre.HTML) {
                        /*
                         * For backward compatibility, read the OpenGrok-produced document
                         * using the system default charset.
                         */
                        r = new InputStreamReader(_xrefIn);
                        /*
                         * dumpXref() is also useful here for translating links.
                         */
                        Util.dumpXref(out, r, request.getContextPath(), resourceFile);
                    } else {
    %>Download binary file, <a href="<%= rawPath %>?<%= QueryParameters.REVISION_PARAM_EQ %>
<%= Util.uriEncode(rev) %>"><%= basename %></a><%
                    }
                }
            } catch (IOException e) {
                LOGGER.log(Level.SEVERE, "Failed xref on-the-fly", e);
            } finally {
                if (r != null) {
                    IOUtils.close(r);
                    _xrefIn = null;
                }
                if (_xrefIn != null) {
                    IOUtils.close(_xrefIn);
                    _xrefIn = null;
                }
                if (_xrefTempf != null) {
                    _xrefTempf.delete();
                }
            }
    %></pre>
</div><%
        } else {
%>
<div class="xref-error">
<h3 class="error">Error reading file</h3><%
            if (_xrefError != null) {
%>
<p class="error"><%= Util.htmlize(_xrefError) %></p><%
            }
%>
</div><%
        }
    } else if (_xrefG == AbstractAnalyzer.Genre.IMAGE) {
%>
<div id="src" class="xref-paper xref-paper-image" data-navigate-window-enabled="<%= navigateWindowEnabled %>">
    <div class="xref-paper-inner">
    <img src="<%= rawPath %>?<%= QueryParameters.REVISION_PARAM_EQ %><%= Util.uriEncode(rev) %>"
         alt="from Source Repository"/>
    </div>
</div><%
    } else {
%>
<div id="src" class="xref-paper xref-paper-binary" data-navigate-window-enabled="<%= navigateWindowEnabled %>">
    <div class="xref-paper-inner">
    Download binary file, <a href="<%= rawPath %>?<%= QueryParameters.REVISION_PARAM_EQ %>
<%= Util.uriEncode(rev) %>"><%= basename %></a>
    </div>
</div><%
    }
}
/* ---------------------- xref.jspf end --------------------- */
%>
