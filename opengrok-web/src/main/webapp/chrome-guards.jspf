<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="
org.opengrok.web.PageConfig,
jakarta.servlet.http.HttpServletResponse" %>

<%-- chrome-guards.jspf start

  Early-exit guards for the unified chrome. Translates short-circuits
  into response status / redirect / 304 (via PageConfig) and returns
  from the calling JSP's _jspService so no HTML is emitted.

  Lives as a *static-include* fragment (not a real servlet) so that
  `return` exits the calling page's service method directly. Must be
  included *before any HTML output* by the calling page; that contract
  is enforced by pageheader.jspf.

  Extracted from the legacy mast.jsp (which used to also open
  <main class="container"> — that responsibility now belongs to the
  calling page itself; this fragment produces no HTML at all).
--%>
<%
{
    PageConfig _chromeGuardCfg = PageConfig.get(request);
    if (_chromeGuardCfg.isUnreadable()) {
        response.sendError(HttpServletResponse.SC_FORBIDDEN);
        return;
    }

    String _chromeRedirect = _chromeGuardCfg.canProcess();
    if (_chromeRedirect == null || !_chromeRedirect.isEmpty()) {
        if (_chromeRedirect == null) {
            response.sendError(HttpServletResponse.SC_NOT_FOUND);
        } else {
            response.sendRedirect(_chromeRedirect);
        }
        return;
    }

    if (_chromeGuardCfg.isNotModified(request, response)) {
        return;
    }
}
%>